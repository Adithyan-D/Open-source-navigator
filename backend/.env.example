# Backend Environment Variables Example
# Copy this file to .env and populate with production values

# Application Environment ('development' or 'production')
ENVIRONMENT=development

# Database URL
# SQLite default for local development:
DATABASE_URL=sqlite:///./sql_app.db
# PostgreSQL for production (e.g., Neon, Supabase, Render Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Secret Key for JWT Token Generation (REQUIRED in production: generate using `openssl rand -hex 32`)
SECRET_KEY=super_secret_key_for_development_only_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated list of origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Google Gemini API Key (Required for AI insights & contribution roadmap)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# GitHub Personal Access Token (Optional, but highly recommended to avoid 60 req/hr rate limits)
# Generates 5,000 req/hr. Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
