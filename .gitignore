# ==========================================
# Open Source Navigator - Master .gitignore
# ==========================================

# ------------------------------------------
# Environment & Secrets (Never commit credentials)
# ------------------------------------------
.env
.env.*
!.env.example
.envrc
*.local

# ------------------------------------------
# Python & Virtual Environments
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
.installed.cfg
*.egg
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

# ------------------------------------------
# Python Testing, Linters & Coverage
# ------------------------------------------
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.cache
.hypothesis/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# ------------------------------------------
# JavaScript / Node / Frontend
# ------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.vite/
**/.vite/
.vite-temp/
**/.vite-temp/

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Databases, Local Storage & State
# ------------------------------------------
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db-journal
*.db-wal
*.db-shm
sql_app.db
pgdata/
**/pgdata/

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------
# IDEs & Code Editors
# ------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
tempCodeRunnerFile.py

# ------------------------------------------
# Docker & Temporary Files
# ------------------------------------------
*.log
*.tmp
*.temp
*.bak
docker-compose.override.yml
